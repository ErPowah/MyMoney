<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:DiarioSpese.Models"
             xmlns:vm="clr-namespace:DiarioSpese.ViewModels"
             xmlns:views="clr-namespace:DiarioSpese.Views"
             x:Class="DiarioSpese.Views.CronologiaPage"
             x:DataType="vm:CronologiaViewModel"
             Title="Cronologia">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="⚙"
                     Clicked="ImpostazioniClic" />
    </ContentPage.ToolbarItems>

    <ContentPage.Resources>
        <!-- Pulsanti per scegliere il tipo di grafico: quello attivo diventa viola -->
        <Style x:Key="Modalita" TargetType="Button">
            <Setter Property="FontFamily" Value="OpenSansRegular" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="MinimumHeightRequest" Value="40" />
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={DynamicResource Secondary}, Dark={StaticResource Gray600}}" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={DynamicResource Tertiary}, Dark={StaticResource White}}" />
        </Style>

        <Style x:Key="Etichetta" TargetType="Label">
            <Setter Property="FontFamily" Value="OpenSansRegular" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="16"
                             Spacing="12">

            <HorizontalStackLayout Spacing="8">
                <Button Text="Colonne"
                        Style="{StaticResource Modalita}"
                        Command="{Binding ModalitaCommand}"
                        CommandParameter="colonne">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button"
                                     Binding="{Binding ModalitaColonne}"
                                     Value="True">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource GraficoScuro}}" />
                            <Setter Property="TextColor" Value="{StaticResource White}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Text="Linee"
                        Style="{StaticResource Modalita}"
                        Command="{Binding ModalitaCommand}"
                        CommandParameter="linee">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button"
                                     Binding="{Binding ModalitaLinee}"
                                     Value="True">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource GraficoScuro}}" />
                            <Setter Property="TextColor" Value="{StaticResource White}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </HorizontalStackLayout>

            <!-- ===== Modo "Colonne": totale di ogni mese, con filtro per categoria ===== -->
            <VerticalStackLayout IsVisible="{Binding ModalitaColonne}"
                                 Spacing="12">
                <VerticalStackLayout>
                    <Label Text="Categoria"
                           Style="{StaticResource Etichetta}" />
                    <Picker Title="Categoria"
                            ItemsSource="{Binding Filtri}"
                            SelectedItem="{Binding Filtro}" />
                </VerticalStackLayout>

                <Label Text="Totale mensile, ultimi 12 mesi. Tocca un mese per vederne le spese."
                       Style="{StaticResource Etichetta}" />

                <!-- 12 colonne della griglia, una per mese. Il mese scelto è viola, gli altri grigi. -->
                <Grid HeightRequest="160"
                      ColumnDefinitions="*,*,*,*,*,*,*,*,*,*,*,*"
                      BindableLayout.ItemsSource="{Binding Colonne}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:ColonnaMese">
                            <Grid Grid.Column="{Binding Indice}"
                                  RowDefinitions="*,1,Auto"
                                  BackgroundColor="Transparent"
                                  SemanticProperties.Description="{Binding Descrizione}">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelezionaMeseCommand, Source={RelativeSource AncestorType={x:Type vm:CronologiaViewModel}}, x:DataType=vm:CronologiaViewModel}"
                                                          CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>

                                <AbsoluteLayout>
                                    <Border AbsoluteLayout.LayoutFlags="PositionProportional,HeightProportional"
                                            AbsoluteLayout.LayoutBounds="{Binding Barra}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 4,4,0,0"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border"
                                                         Binding="{Binding Selezionata}"
                                                         Value="True">
                                                <Setter Property="BackgroundColor"
                                                        Value="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource GraficoScuro}}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                    </Border>
                                </AbsoluteLayout>

                                <!-- Linea di base -->
                                <BoxView Grid.Row="1"
                                         BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />

                                <Label Grid.Row="2"
                                       Text="{Binding Etichetta}"
                                       FontSize="11"
                                       Margin="0,4,0,0"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding Selezionata}"
                                                     Value="True">
                                            <Setter Property="FontAttributes" Value="Bold" />
                                            <Setter Property="TextColor"
                                                    Value="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </Grid>
            </VerticalStackLayout>

            <!-- ===== Modo "Linee": una linea per categoria, ognuna da mostrare o nascondere ===== -->
            <VerticalStackLayout IsVisible="{Binding ModalitaLinee}"
                                 Spacing="12">
                <Label Text="Tocca una voce per mostrare o nascondere la sua linea. «Tutte le categorie» è la somma di tutte."
                       Style="{StaticResource Etichetta}" />

                <!-- Legenda: ogni voce ha il colore della sua linea; piena se visibile, vuota se nascosta -->
                <FlexLayout Wrap="Wrap"
                            BindableLayout.ItemsSource="{Binding Serie}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:SerieMensile">
                            <Border FlexLayout.Shrink="0"
                                    Margin="0,0,8,8"
                                    Padding="12,7"
                                    StrokeShape="RoundRectangle 16"
                                    StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray500}}"
                                    BackgroundColor="Transparent">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding AlternaSerieCommand, Source={RelativeSource AncestorType={x:Type vm:CronologiaViewModel}}, x:DataType=vm:CronologiaViewModel}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border"
                                                 Binding="{Binding Visibile}"
                                                 Value="True">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={DynamicResource Secondary}, Dark={StaticResource Gray600}}" />
                                        <Setter Property="Stroke" Value="Transparent" />
                                    </DataTrigger>
                                </Border.Triggers>

                                <HorizontalStackLayout Spacing="6">
                                    <BoxView WidthRequest="14"
                                             HeightRequest="3"
                                             CornerRadius="1.5"
                                             VerticalOptions="Center"
                                             Color="{Binding Colore}"
                                             BackgroundColor="Transparent"
                                             Opacity="0.35">
                                        <BoxView.Triggers>
                                            <DataTrigger TargetType="BoxView"
                                                         Binding="{Binding Visibile}"
                                                         Value="True">
                                                <Setter Property="Opacity" Value="1" />
                                            </DataTrigger>
                                        </BoxView.Triggers>
                                    </BoxView>
                                    <Label Text="{Binding Nome}"
                                           FontSize="13"
                                           Style="{StaticResource Etichetta}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label"
                                                         Binding="{Binding Visibile}"
                                                         Value="True">
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </HorizontalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>

                <!-- Il grafico: disegnato da Views/GraficoLinee.cs. Tocca un punto per scegliere il mese. -->
                <views:GraficoLinee HeightRequest="220"
                                    Serie="{Binding SerieVisibili}"
                                    Etichette="{Binding EtichetteMesi}"
                                    IndiceSelezionato="{Binding IndiceMeseScelto}"
                                    ToccoCommand="{Binding SelezionaIndiceCommand}"
                                    SemanticProperties.Description="Grafico a linee delle spese mensili" />

                <Label Text="Scegli almeno una voce da mostrare."
                       IsVisible="{Binding NessunaSerie}"
                       Style="{StaticResource Etichetta}" />
            </VerticalStackLayout>

            <!-- ===== Il mese scelto: totale, valori delle linee ed elenco delle spese ===== -->
            <Grid ColumnDefinitions="*,Auto"
                  Margin="0,12,0,0">
                <Label Text="{Binding TitoloMese}"
                       FontSize="20"
                       FontFamily="OpenSansSemibold" />
                <Label Grid.Column="1"
                       Text="{Binding TotaleMese, StringFormat='{0:C}'}"
                       FontSize="20"
                       FontFamily="OpenSansSemibold" />
            </Grid>

            <!-- Nel modo Linee: il valore di ogni linea visibile nel mese scelto, in una piccola tabella -->
            <VerticalStackLayout Spacing="8"
                                 IsVisible="{Binding ModalitaLinee}"
                                 BindableLayout.ItemsSource="{Binding SerieVisibili}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:SerieMensile">
                        <Grid ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="8">
                            <BoxView WidthRequest="14"
                                     HeightRequest="3"
                                     CornerRadius="1.5"
                                     VerticalOptions="Center"
                                     Color="{Binding Colore}"
                                     BackgroundColor="Transparent" />
                            <Label Grid.Column="1"
                                   Text="{Binding Nome}" />
                            <Label Grid.Column="2"
                                   Text="{Binding ValoreMese, StringFormat='{0:C}'}"
                                   FontFamily="OpenSansSemibold" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Label Text="Nessuna spesa in questo mese."
                   IsVisible="{Binding MeseVuoto}"
                   Style="{StaticResource Etichetta}" />

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding SpeseDelMese}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:Spesa">
                        <views:RigaSpesaView>
                            <!-- Tocca la riga per modificarla -->
                            <views:RigaSpesaView.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ModificaCommand, Source={RelativeSource AncestorType={x:Type vm:CronologiaViewModel}}, x:DataType=vm:CronologiaViewModel}"
                                                      CommandParameter="{Binding .}" />
                            </views:RigaSpesaView.GestureRecognizers>
                        </views:RigaSpesaView>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
