<?xml version="1.0" encoding="utf-8" ?>
<!-- Una riga dell'elenco spese: la usano sia la scheda Spese sia la scheda Cronologia -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:DiarioSpese.Models"
             x:Class="DiarioSpese.Views.RigaSpesaView"
             x:DataType="models:Spesa">

    <Grid ColumnDefinitions="*,Auto"
          ColumnSpacing="12"
          Padding="4,12">
        <VerticalStackLayout Spacing="2">
            <Label Text="{Binding Descrizione}"
                   FontSize="16"
                   FontAttributes="Bold" />
            <Label TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="{Binding Data, StringFormat='{0:ddd d MMM yyyy}'}" />
                        <Span Text=" · " />
                        <Span Text="{Binding Categoria}" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>
        </VerticalStackLayout>

        <Label Grid.Column="1"
               Text="{Binding Importo, StringFormat='{0:C}'}"
               FontSize="16"
               VerticalOptions="Center" />
    </Grid>
</ContentView>
