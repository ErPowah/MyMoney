<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DiarioSpese.ViewModels"
             x:Class="DiarioSpese.Views.SpesaPage"
             x:DataType="vm:SpesaViewModel"
             Title="{Binding Titolo}">

    <ScrollView>
        <VerticalStackLayout Padding="16"
                             Spacing="8">

            <Label Text="Descrizione" />
            <Entry Text="{Binding Descrizione}"
                   Placeholder="Es. spesa al supermercato" />

            <Label Text="Importo (€)" />
            <Entry Text="{Binding Importo}"
                   Placeholder="0,00"
                   Keyboard="Numeric" />

            <Label Text="Data" />
            <DatePicker Date="{Binding Data}"
                        Format="dd/MM/yyyy" />

            <Label Text="Categoria" />
            <Picker Title="Scegli una categoria"
                    ItemsSource="{Binding Categorie}"
                    SelectedItem="{Binding Categoria}" />

            <Button Text="Salva"
                    Command="{Binding SalvaCommand}"
                    Margin="0,16,0,0" />

            <Button Text="Elimina"
                    Command="{Binding EliminaCommand}"
                    IsVisible="{Binding InModifica}"
                    BackgroundColor="#D32F2F"
                    TextColor="White" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
