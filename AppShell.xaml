<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="DiarioSpese.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:DiarioSpese.Views"
    Title="Diario spese">

    <!-- Le tre schede in basso. Le icone sono SVG in Resources/Images, convertite in PNG durante la compilazione -->
    <TabBar>
        <ShellContent
            Title="Spese"
            Icon="tab_spese.png"
            ContentTemplate="{DataTemplate views:ElencoSpesePage}"
            Route="ElencoSpese" />

        <ShellContent
            Title="Cronologia"
            Icon="tab_cronologia.png"
            ContentTemplate="{DataTemplate views:CronologiaPage}"
            Route="Cronologia" />

        <ShellContent
            Title="Analisi"
            Icon="tab_analisi.png"
            ContentTemplate="{DataTemplate views:AnalisiPage}"
            Route="Analisi" />
    </TabBar>

</Shell>
